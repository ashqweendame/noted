# Server-side Gemini API key (NEVER expose this in VITE_* variables or frontend code)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Web API key (the "apiKey" value in firebase-applet-config.json).
# Used server-side to verify the student's Firebase ID token before calling Gemini,
# so the analyze endpoint cannot be abused by anonymous visitors.
FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"

# Express server port for local development and Node.js hosting
PORT="3000"

# Public URL where the application is hosted (used for self-referential links)
APP_URL="MY_APP_URL"

# Firebase web configuration:
# Noted reads the public Firebase client config from /firebase-applet-config.json.
# Do NOT store private service account keys or GEMINI_API_KEY in client environment variables.
