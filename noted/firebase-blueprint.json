{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated DCISM student profile isolating personal announcements and calendar events.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified student email address.",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Verified DCISM academic announcement saved by the student, serving as the single source of truth for Dashboard deadlines and Academic Calendar events.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Announcement headline.",
          "minLength": 1,
          "maxLength": 200
        },
        "originalText": {
          "type": "string",
          "description": "Extracted verbatim text or empty string if omitted.",
          "maxLength": 8000
        },
        "category": {
          "type": "string",
          "enum": [
            "Examination",
            "Enrollment",
            "Submission Deadline",
            "Academic Requirement",
            "Event / Seminar",
            "General Notice",
            "Other"
          ],
          "description": "Academic announcement category."
        },
        "shortSummary": {
          "type": "string",
          "description": "Concise 1-3 sentence summary.",
          "minLength": 1,
          "maxLength": 1500
        },
        "targetAudience": {
          "type": "string",
          "description": "Target DCISM student group or empty string if unspecified.",
          "maxLength": 200
        },
        "importantDates": {
          "type": "array",
          "description": "Important schedule dates extracted from the announcement."
        },
        "deadlines": {
          "type": "array",
          "description": "Actionable deadlines with completion state."
        },
        "requiredActions": {
          "type": "array",
          "description": "Actionable checklist items with completion state."
        },
        "requiredDocuments": {
          "type": "array",
          "description": "List of required documents."
        },
        "priority": {
          "type": "string",
          "enum": ["High", "Medium", "Low"],
          "description": "Academic urgency priority."
        },
        "uncertainOrMissingInfo": {
          "type": "array",
          "description": "Warnings about ambiguous, relative, or unreadable details."
        },
        "imageUrl": {
          "type": "string",
          "description": "Compressed preview thumbnail or static asset path (empty string if omitted).",
          "maxLength": 250000
        },
        "imageName": {
          "type": "string",
          "description": "Original uploaded filename or empty string.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "originalText",
        "category",
        "shortSummary",
        "targetAudience",
        "importantDates",
        "deadlines",
        "requiredActions",
        "requiredDocuments",
        "priority",
        "uncertainOrMissingInfo",
        "imageUrl",
        "imageName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private profile document for an authenticated DCISM student."
    },
    "/users/{userId}/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Verified academic announcements owned by the student; also drives Academic Calendar events without duplicate records."
    }
  }
}
